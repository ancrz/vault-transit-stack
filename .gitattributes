# Auto-detect text files and normalize line endings
* text=auto

# Force LF on scripts and configuration
*.sh text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.hcl text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files (no diff, no merge)
*.tgz binary
*.tar.gz binary
*.zip binary
*.png binary
*.jpg binary
*.gif binary
