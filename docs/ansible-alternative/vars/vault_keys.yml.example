# =============================================================================
# Vault Unseal Keys — EXAMPLE FILE
# =============================================================================
# DO NOT put real keys here. This file is committed to git as a template.
#
# To create your encrypted keys file:
#   1. cp vault_keys.yml.example vault_keys.yml
#   2. Replace placeholder values with real unseal keys
#   3. Encrypt: ansible-vault encrypt vault_keys.yml
#
# To edit later: ansible-vault edit vault_keys.yml
# =============================================================================

# Vault server connection
vault_addr: "http://127.0.0.1:8200"

# Unseal key shares (from: vault operator init -format=json)
# Only need KEY_THRESHOLD number of keys (default: 3 of 5)
vault_unseal_keys:
  - "REPLACE_WITH_UNSEAL_KEY_1"
  - "REPLACE_WITH_UNSEAL_KEY_2"
  - "REPLACE_WITH_UNSEAL_KEY_3"
