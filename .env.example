# =============================================
# VAULT TRANSIT STACK — Environment Variables
# =============================================
# Copy to .env before starting:
#   cp .env.example .env
#
# NOTE: Unseal keys are NOT stored in this file.
# They are managed via Ansible Vault encrypted file.
# See ansible/README.md for setup instructions.

# === COMPOSE INFRASTRUCTURE ===
COMPOSE_PROJECT_NAME=vault-transit
NETWORK_NAME=vault-internal

# === IMAGE VERSION (pin to specific tag) ===
VAULT_TAG=1.15.4

# === HOST IDENTITY (non-root container mapping) ===
HOST_UID=1000
HOST_GID=1000

# === PORT MAPPING (localhost only for security) ===
VAULT_PORT=8200

# === VAULT CONFIGURATION ===
VAULT_CONTAINER_NAME=vault-server
VAULT_CONTAINER_LISTEN_PORT=8200
VAULT_INTERNAL_ADDR=http://127.0.0.1:8200
VAULT_LOG_LEVEL=info

# === INITIALIZATION PARAMETERS ===
# Used during: vault operator init (first-time setup only)
VAULT_KEY_SHARES=5
VAULT_KEY_THRESHOLD=3

# === UNSEALER SIDECAR ===
# Poll interval in seconds (how often to check seal status)
UNSEALER_POLL_INTERVAL=10
# Path inside container to the unseal keys file
UNSEALER_KEYS_FILE=/run/secrets/vault_keys.json
# Resource limits for the lightweight sidecar
UNSEALER_MEM_LIMIT=64m
UNSEALER_MEM_RESERVATION=32m

# === RESOURCE LIMITS ===
VAULT_MEM_LIMIT=256m
VAULT_MEM_RESERVATION=128m
