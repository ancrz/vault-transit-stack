# =============================================
# VAULT TRANSIT STACK — OpenBao + transit mini KMS
# =============================================
# cp .env.example .env   (scripts/start.sh does it on first run)
# No secret lives here: keys and AppRole credentials are generated under secrets/ by
# scripts/init.sh (gitignored).

COMPOSE_PROJECT_NAME=vault-transit
BAO_CONTAINER_PREFIX=bao
BAO_RESTART_POLICY=unless-stopped
BAO_LOG_MAX_SIZE=10m
BAO_LOG_MAX_FILE=5

# Image (pin a specific tag)
OPENBAO_IMAGE=openbao/openbao:2.7.0

# Host identity: the containers run as this user and read secrets/ and data/ owned by it.
# Consumers add HOST_GID to their container (group_add) to read their AppRole files.
HOST_UID=1000
HOST_GID=1000

# Networks. The secrets network is the one consumers join (external: true). AppRole tokens
# and secret-ids are bound to its subnet: change both here and re-run scripts/init.sh.
BAO_KMS_NETWORK_NAME=bao-kms-net
BAO_KMS_SUBNET=172.30.48.0/24
BAO_SECRETS_NETWORK_NAME=bao-secrets-net
BAO_SECRETS_SUBNET=172.30.30.0/24

# AppRole secret_id lifetime and rotation window (seal AppRole and consumers).
# scripts/init.sh rotates a secret_id when less than the window is left: run it monthly.
BAO_SEAL_SECRET_TTL=8760h
BAO_SEAL_ROTATE_BEFORE_H=720

# Consumers reach the store at https://openbao-secrets:8200 (the secrets-network alias).

# Declarative configuration applied by scripts/init.sh
BAO_CONSUMERS_FILE=./config/consumers.json
BAO_POLICY_DIR=./config/policies

# TLS (scripts/certs.sh): server certificate and CA lifetimes in days
BAO_CERT_DAYS=397
BAO_CA_DAYS=3650

# Resource limits
OPENBAO_KMS_MEM_LIMIT=128m
OPENBAO_KMS_CPU_LIMIT=0.25
OPENBAO_MEM_LIMIT=256m
OPENBAO_CPU_LIMIT=0.5

# Healthchecks
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=5
