# =============================================
# VAULT TRANSIT STACK — Environment Variables
# =============================================
# Copy to .env and fill in secrets before starting:
#   cp .env.example .env

# === COMPOSE INFRASTRUCTURE ===
COMPOSE_PROJECT_NAME=vault-transit
NETWORK_NAME=vault-internal

# === IMAGE VERSION (pin to specific tag, avoid latest) ===
VAULT_TAG=1.15.4

# === HOST IDENTITY (non-root container mapping) ===
# Renamed from UID/GID to avoid POSIX shell builtin collision
HOST_UID=1000
HOST_GID=1000

# === PORT MAPPING (localhost only for security) ===
VAULT_A_PORT=8282
VAULT_B_PORT=8283

# === VAULT COMMON ===
VAULT_CONTAINER_LISTEN_PORT=8200

# === VAULT-A CONFIGURATION ===
# Internal address vault-a uses for self-referencing API calls
VAULT_INTERNAL_ADDR=http://127.0.0.1:8200

# === VAULT-A TRANSIT ENGINE (used during initial setup ONLY) ===
# Root token for vault-a — generate during: vault operator init (Step 3)
VAULT_ROOT_TOKEN_FOR_TRANSIT=
# Transit key and mount configuration
VAULT_TRANSIT_KEY_NAME=autounseal
VAULT_TRANSIT_MOUNT_PATH=transit/

# === VAULT INITIALIZATION PARAMETERS ===
VAULT_KEY_SHARES=1
VAULT_KEY_THRESHOLD=1

# === SECRETS (populated during first-time setup) ===
# Unseal key for vault-a auto-unseal on restart
# Generated during: vault operator init (see docs/first-time-setup.md Step 3)
VAULT_A_UNSEAL_KEY=

# Transit token for vault-b auto-unseal via vault-a
# Generated during: vault token create -policy=autounseal (see docs/first-time-setup.md Step 6)
VAULT_B_TRANSIT_TOKEN=

# === RESOURCE LIMITS (adjust per host capacity) ===
VAULT_A_MEM_LIMIT=256m
VAULT_A_MEM_RESERVATION=128m
VAULT_B_MEM_LIMIT=256m
VAULT_B_MEM_RESERVATION=128m
